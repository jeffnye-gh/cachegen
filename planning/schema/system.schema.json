{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uarchlabs.com/schemas/cachegen/system-0.10.0.json",
  "title": "cachegen system",
  "type": "object",
  "required": [
    "schema_version",
    "file_type",
    "name",
    "include"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.10.0"
    },
    "file_type": {
      "const": "system"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 32
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/include_entry"
      }
    }
  },
  "$defs": {
    "include_entry": {
      "type": "object",
      "required": [
        "file",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "caches",
            "links",
            "topology",
            "ports"
          ]
        }
      }
    }
  }
}