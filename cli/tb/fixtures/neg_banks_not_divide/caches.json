{
  "schema_version": "0.13.0",
  "file_type": "caches",
  "include": [
    {
      "file": "../base/base_ports.json",
      "type": "ports"
    }
  ],
  "caches": {
    "cpu": {
      "node_type": "agent",
      "interfaces": {
        "mem": {
          "link": "l_core",
          "ports": {
            "req": "p_init"
          }
        }
      }
    },
    "l1": {
      "node_type": "icache",
