        "data_array": {
          "kind": "inferred_sram",
          "read_port": "registered",
          "byte_enables": false,
          "cleared_on_reset": false
        },
        "valid_bits": {
          "kind": "flop_file",
          "read_port": "combinational",
          "byte_enables": false,
          "cleared_on_reset": true
        },
        "replacement_bits": {
          "kind": "flop_file",
          "read_port": "combinational",
          "byte_enables": false,
          "cleared_on_reset": true
        }
      },
      "maintenance": {
        "invalidate_line": true,
        "invalidate_all": true,
        "flush_line": false,
        "flush_all": false
